# Frontend (Vite)
# Use MariaDB persistence through the Express API.
VITE_STORAGE_BACKEND=mariadb
VITE_MARIADB_API_URL=/api

# Local LLM provider endpoints.
# In development, Vite proxies LM Studio through /api/llm-studio.
# These absolute URLs are used by production builds or reverse-proxy setups.
VITE_LMSTUDIO_ENDPOINT=http://localhost:1234
VITE_OLLAMA_ENDPOINT=http://localhost:11434

# Backend (Express API)
API_PORT=3001

# MariaDB connection
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=ai_brainstormer_user
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=ai_brainstormer
