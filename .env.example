# Storage Backend: "mariadb" or "supabase"
VITE_STORAGE_BACKEND=mariadb

# ── MariaDB Configuration (used when VITE_STORAGE_BACKEND=mariadb) ──
# These are read by the Express API server in server/
MARIADB_HOST=192.168.x.x
MARIADB_PORT=3306
MARIADB_USER=your-db-user
MARIADB_PASSWORD=your-db-password
MARIADB_DATABASE=project_brainstormer

# ── Supabase Configuration (used when VITE_STORAGE_BACKEND=supabase) ──
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
